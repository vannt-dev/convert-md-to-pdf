{
  "name": "md-pdf-studio",
  "version": "2.3.0",
  "description": "A powerful CLI tool and Manifest V3 Browser Extension to convert Markdown files, text, or web pages into beautifully styled PDFs with Mermaid diagrams, LaTeX math, TOC, and themes. The CLI also writes Word (.docx) and EPUB.",
  "main": "src/core/index.js",
  "bin": {
    "md-pdf-studio": "bin/cli.js",
    "md2pdf": "bin/cli.js",
    "convert-md-to-pdf": "bin/cli.js"
  },
  "files": [
    "bin/",
    "src/"
  ],
  "scripts": {
    "start": "node bin/cli.js",
    "build:extension": "node scripts/build-extension.js",
    "fetch:libs": "node scripts/fetch-vendor-libs.js",
    "pre-commit": "node scripts/pre-commit.js",
    "check:commit": "node scripts/check-commit.js",
    "release": "node scripts/release.js",
    "test": "node tests/index.test.js",
    "test:sample": "node bin/cli.js examples/sample.md --toc -c examples/custom.css -o output_test.pdf"
  },
  "keywords": [
    "markdown",
    "pdf",
    "cli",
    "converter",
    "chrome-extension",
    "mermaid",
    "katex",
    "md2pdf",
    "marked",
    "md-pdf-studio",
    "markdown-to-pdf",
    "docx",
    "epub"
  ],
  "author": "vannt-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vannt-dev/convert-md-to-pdf.git"
  },
  "homepage": "https://github.com/vannt-dev/convert-md-to-pdf#readme",
  "bugs": {
    "url": "https://github.com/vannt-dev/convert-md-to-pdf/issues"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "adm-zip": "^0.6.0",
    "lefthook": "^2.1.14"
  }
}
