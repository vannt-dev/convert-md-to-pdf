{
  "name": "convert-md-to-pdf",
  "version": "1.0.0",
  "description": "A powerful CLI tool to convert Markdown files to styled, high-quality PDFs with support for Mermaid diagrams, Math (KaTeX), code highlighting, ASCII mockups, and CJK/Vietnamese typography.",
  "main": "src/index.js",
  "bin": {
    "convert-md-to-pdf": "bin/cli.js",
    "md2pdf": "bin/cli.js"
  },
  "scripts": {
    "start": "node bin/cli.js",
    "test": "node bin/cli.js examples/sample.md -o output_test.pdf"
  },
  "keywords": [
    "markdown",
    "pdf",
    "cli",
    "converter",
    "mermaid",
    "katex",
    "md2pdf",
    "marked",
    "chrome",
    "edge"
  ],
  "author": "vannt-dev",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "marked": "^12.0.2"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
